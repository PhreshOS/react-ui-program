{
  "name": "react-ui-program",
  "displayName": "React UI Preview",
  "private": true,
  "version": "0.1.3",
  "description": "An interactive preview of PhreshOS React UI components.",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "phresh dev",
    "start": "phresh start",
    "pack": "phresh pack",
    "check": "tsc --noEmit",
    "build": "vite build --config vite.client.ts",
    "test": "vitest run --project default",
    "verify": "node --run check && node --run build && node --run test"
  },
  "dependencies": {
    "@phreshos/client": "^0.1.43",
    "@phreshos/core": "^0.1.49",
    "@phreshos/react": "^0.1.25",
    "@phreshos/react-ui": "^0.1.22",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@phreshos/cli": "^0.1.60",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
